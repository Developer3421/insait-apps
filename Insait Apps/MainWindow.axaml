<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Insait_Apps.MainWindow"
        Title="Insait Apps"
        Width="1280" Height="720"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="{StaticResource BackgroundBrush}"
        Icon="/Icons/InsaitLogo.png">

    <Grid RowDefinitions="40,*">
        <Border Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}" PointerPressed="TitleBar_PointerPressed"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource SeparatorBrush}">
            <Border.Styles>
                <Style Selector="Button.btn-ctrl, Button.btn-win">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Width" Value="46" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Style>
                <Style Selector="Button.btn-close">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Width" Value="46" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Style>
                <Style Selector="Button.btn-close:pointerover">
                    <Setter Property="Background" Value="{StaticResource HoverCloseBrush}" />
                </Style>
                <Style Selector="Button.btn-win:pointerover">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="Button.btn-win:pressed">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="RenderTransform" Value="none" />
                </Style>
                <Style Selector="Button.btn-ctrl:pointerover">
                    <Setter Property="Background" Value="{StaticResource TitleBarHoverBrush}" />
                </Style>
                <Style Selector="Border.lang-btn">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Margin" Value="2,0" />
                </Style>
                <Style Selector="Border.lang-btn:pointerover">
                    <Setter Property="Background" Value="{StaticResource TitleBarHoverBrush}" />
                </Style>
                <Style Selector="Border.lang-btn.active">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                </Style>
            </Border.Styles>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Width="18" Height="18" Stretch="Uniform" Source="/Icons/InsaitLogo.png" />
                    <TextBlock Text="Insait Apps — Desktop"
                               Foreground="{StaticResource TitleBarForegroundBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="Transparent" />

                <StackPanel x:Name="LangStack" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border Classes="lang-btn" Tag="en" PointerPressed="OnLanguageClick">
                        <TextBlock Text="EN" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBarForegroundBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <Border Classes="lang-btn" Tag="uk" PointerPressed="OnLanguageClick">
                        <TextBlock Text="UK" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBarForegroundBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <Border Classes="lang-btn" Tag="ru" PointerPressed="OnLanguageClick">
                        <TextBlock Text="RU" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBarForegroundBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <Border Classes="lang-btn" Tag="de" PointerPressed="OnLanguageClick">
                        <TextBlock Text="DE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBarForegroundBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <Border Classes="lang-btn" Tag="tr" PointerPressed="OnLanguageClick">
                        <TextBlock Text="TR" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBarForegroundBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>

                <Border Grid.Column="3" Width="40" Background="Transparent"
                        PointerPressed="OnAboutClick">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4"
                            Width="30" Height="30"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#x2139;" FontSize="16"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </Border>
                <Border Grid.Column="4" Width="40" Background="Transparent"
                        PointerPressed="OnUserAgreementClick">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4"
                            Width="30" Height="30"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#x2696;" FontSize="16"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </Border>

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Classes="btn-ctrl" Tag="Minimize" Click="Minimize_Click">
                        <Image Stretch="Uniform" Source="/Icons/MinButton.png" />
                    </Button>
                    <Button x:Name="MaximizeButton" Classes="btn-ctrl" Tag="Maximize" Click="Maximize_Click">
                        <Image Stretch="Uniform" Source="/Icons/MaxButton.png" />
                    </Button>
                    <Button Classes="btn-close" Tag="Close" Click="Close_Click">
                        <Image Stretch="Uniform" Source="/Icons/CloseButton.png" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <NativeWebView Grid.Row="1" x:Name="webView" Source="https://insaitapps.eu" />
    </Grid>
</Window>
