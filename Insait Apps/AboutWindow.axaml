<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="400" d:DesignHeight="320"
        x:Class="Insait_Apps.AboutWindow"
        Title="About Insait Apps"
        Width="400" Height="340"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        Background="{StaticResource BackgroundBrush}"
        Icon="/Icons/InsaitLogo.png">

    <Grid RowDefinitions="40,*">
        <Border Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}" PointerPressed="OnTitleBarPointerPressed"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource SeparatorBrush}">
            <Border.Styles>
                <Style Selector="Button.btn-close">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Width" Value="46" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Style>
                <Style Selector="Button.btn-close:pointerover">
                    <Setter Property="Background" Value="{StaticResource HoverCloseBrush}" />
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="TitleBarText" Grid.Column="0" Text="About Insait Apps"
                           Foreground="{StaticResource TitleBarForegroundBrush}"
                           FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
                <Button Grid.Column="1" Classes="btn-close" Click="OnCloseClick">
                    <Image Width="18" Height="18" Stretch="Uniform" Source="/Icons/CloseButton.png" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="12" Margin="30,0">
            <Image Width="64" Height="64" Stretch="Uniform" Source="/Icons/InsaitLogo.png" />
            <TextBlock Text="Insait Apps"
                       Foreground="{StaticResource ForegroundBrush}"
                       FontWeight="Bold" FontSize="20"
                       HorizontalAlignment="Center" />
            <Separator Background="{StaticResource SeparatorBrush}" Height="1" Margin="0,4" />
            <TextBlock x:Name="VersionText" Text="Version 1.0.0"
                       Foreground="{StaticResource SecondaryForegroundBrush}"
                       FontSize="14" HorizontalAlignment="Center" />
            <TextBlock x:Name="AuthorText" Text="Author: Oleh Kurylo"
                       Foreground="{StaticResource SecondaryForegroundBrush}"
                       FontSize="14" HorizontalAlignment="Center" />
            <TextBlock x:Name="BuiltText" Text="Built: 03.07.2026"
                       Foreground="{StaticResource SecondaryForegroundBrush}"
                       FontSize="14" HorizontalAlignment="Center" />
            <TextBlock x:Name="CopyrightText" Text="&#x00A9; 2026 Insait Apps. All rights reserved."
                       Foreground="{StaticResource SecondaryForegroundBrush}"
                       FontSize="12" HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</Window>
