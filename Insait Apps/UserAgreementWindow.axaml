<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="520" d:DesignHeight="450"
        x:Class="Insait_Apps.UserAgreementWindow"
        Title="User Agreement"
        Width="520" Height="460"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        Background="{StaticResource BackgroundBrush}"
        Icon="/Icons/InsaitLogo.png">

    <Grid RowDefinitions="40,*">
        <Border Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}" PointerPressed="OnTitleBarPointerPressed"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource SeparatorBrush}">
            <Border.Styles>
                <Style Selector="Button.btn-close">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Width" Value="46" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Style>
                <Style Selector="Button.btn-close:pointerover">
                    <Setter Property="Background" Value="{StaticResource HoverCloseBrush}" />
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="TitleBarText" Grid.Column="0" Text="User Agreement"
                           Foreground="{StaticResource TitleBarForegroundBrush}"
                           FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
                <Button Grid.Column="1" Classes="btn-close" Click="OnCloseClick">
                    <Image Width="18" Height="18" Stretch="Uniform" Source="/Icons/CloseButton.png" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="20">
            <StackPanel Spacing="12">
                <TextBlock x:Name="HeadingText" Text="USER AGREEMENT"
                           Foreground="{StaticResource ForegroundBrush}"
                           FontWeight="Bold" FontSize="16" />
                <TextBlock x:Name="LastUpdatedText" Text="Last updated: 03.07.2026"
                           Foreground="{StaticResource SecondaryForegroundBrush}"
                           FontSize="12" />

                <Separator Background="{StaticResource SeparatorBrush}" Height="1" />

                <TextBlock x:Name="ContentText" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryForegroundBrush}"
                           FontSize="13"
                           LineHeight="20" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
